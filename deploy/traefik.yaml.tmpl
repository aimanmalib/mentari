# Route for the public host name to the mentari container. deploy/deploy.sh fills the @…@ values from
# deploy/hos.env and copies the result into the proxy's dynamic configuration folder.
# HTML is sent with `Cache-Control: no-transform`, so a CDN in front does not compress it: the `compress`
# middleware here does, and its default 1024-byte floor would skip the small index page, so the floor is lowered.
# Plain http redirects to https.
http:
  routers:
    mentari:
      entryPoints: [https]
      rule: Host(`@DOMAIN@`)
      service: mentari-svc
      middlewares: [mentari-compress]
      tls:
        certResolver: @CERT_RESOLVER@
      priority: 100
    mentari-http:
      entryPoints: [http]
      rule: Host(`@DOMAIN@`)
      service: mentari-svc
      middlewares: [mentari-https]
      priority: 100
  middlewares:
    mentari-compress:
      compress:
        minResponseBodyBytes: 256
        excludedContentTypes: [image/png, image/jpeg, image/webp, font/woff2]
    mentari-https:
      redirectScheme:
        scheme: https
        permanent: true
  services:
    mentari-svc:
      loadBalancer:
        servers:
          - url: http://mentari:8080
