{
  "name": "mentari",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "keys": "pnpm --filter @mentari/scripts keys",
    "testnet": "pnpm --filter @mentari/scripts testnet",
    "native": "pnpm --filter @mentari/scripts native",
    "dev": "pnpm --filter @mentari/web dev",
    "build": "pnpm --filter @mentari/web build && pnpm --filter @mentari/server build",
    "start": "pnpm --filter @mentari/server start",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
